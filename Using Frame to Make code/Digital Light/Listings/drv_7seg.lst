   5          // ===== 按你硬件改 =====
   6          #define DATA_BUS  P0
   7          sbit SEG_LE = P2^6;   // 段码锁存
   8          sbit DIG_LE = P2^7;   // 位选锁存
   9          
  10          // 共阴=1（段码1亮）；共阳=0（段码0亮）
  11          #define SEG_ACTIVE_HIGH   1
  12          
  13          // 位选高有效=1 / 低有效=0（看你位选驱动）
  14          #define DIG_ACTIVE_HIGH   0
  15          
  16          // 如果你位序反了：把 (1u<<idx) 改成 (1u<<(7-idx))
  17          static u8 make_digit_mask(u8 idx)
  18          {
  19   1          u8 m = 0x00;
  20   1          if (idx < 8) m = (1u << idx);
  21   1      
  22   1          if (!DIG_ACTIVE_HIGH) m = (u8)(~m);
  23   1          return m;
  24   1      }
  25          
  26          static void latch_seg(u8 seg)
  27          {
  28   1          DATA_BUS = seg;
  29   1          SEG_LE = 1; SEG_LE = 0;
  30   1      }
  31          
  32          static void latch_dig(u8 dig)
  33          {
  34   1          DATA_BUS = dig;
  35   1          DIG_LE = 1; DIG_LE = 0;
  36   1      }
  37          
  38          static void all_digits_off(void)
  39          {
  40   1          latch_dig(DIG_ACTIVE_HIGH ? 0x00 : 0xFF);
  41   1      }
  42          
  43          void DRV_7Seg_Init(void)
  44          {
  45   1          SEG_LE = 0;
  46   1          DIG_LE = 0;
  47   1          all_digits_off();
  48   1          latch_seg(SEG_ACTIVE_HIGH ? 0x00 : 0xFF);
  49   1      }
  50          
  51          void DRV_7Seg_Output(u8 digit_index, u8 seg_code)
  52          {
  53   1          u8 seg = seg_code;
  54   1          u8 dig;
C51 COMPILER V9.60.7.0   DRV_7SEG                                                          01/02/2026 18:35:24 PAGE 2   

  55   1      
  56   1          // 段码极性处理
  57   1          if (!SEG_ACTIVE_HIGH) seg = (u8)(~seg);
  58   1      
